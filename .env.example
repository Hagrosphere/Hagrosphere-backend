# ============================================================
# Hagrosphere Backend - Environment Variables
# Copy to .env and fill in all values before starting
# NEVER commit .env to version control
# ============================================================

# ── App ──────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001

# ── Database ─────────────────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://hagrosphere:your_password@localhost:5432/hagrosphere_db?schema=public"

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=3600

# ── JWT Secrets (generate with: openssl rand -hex 64) ────────
JWT_ACCESS_SECRET=replace_with_64_char_random_hex_string_access
JWT_REFRESH_SECRET=replace_with_64_char_random_hex_string_refresh
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Cookies ──────────────────────────────────────────────────
# Generate: openssl rand -hex 32
COOKIE_SECRET=replace_with_32_char_random_hex_string
COOKIE_SAME_SITE=lax

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,https://hagrosphere.vercel.app

# ── Cloudinary (image uploads) ────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_FOLDER=hagrosphere

# ── Email (SMTP) ──────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=Hagrosphere <no-reply@hagrosphere.com>

# ── App URLs ──────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
ADMIN_EMAIL=admin@hagrosphere.com
